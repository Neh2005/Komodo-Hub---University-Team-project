# Copy this file to .env.local (already gitignored via *.local) and fill in real values.
# .env.local is only for local `npm run dev` — production deploys read the same-named
# secret from GitHub Actions (see .github/workflows/firebase-deploy.yml).

# Optional: connect to the local Firebase emulator suite instead of the real project.
VITE_USE_EMULATOR=false

# Powers the Komodo Hub Helper chatbot's free-text Q&A (src/utils/gemini.js).
# Get a free key at https://aistudio.google.com/apikey
# IMPORTANT: this key ships in the client bundle. In Google AI Studio, restrict it
# under "API restrictions" -> HTTP referrers to your domains, e.g.:
#   https://komodo-hub-4ce8c.web.app/*
#   http://localhost:5173/*
VITE_GEMINI_API_KEY=

